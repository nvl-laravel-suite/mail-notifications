{
    "name": "nvl/mail-notifications",
    "description": "Provider-neutral Laravel mail tracking, scheduling, MailerSend integration, and tokenized presentation",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "mail",
        "email",
        "tracking",
        "notifications",
        "scheduling",
        "mailersend"
    ],
    "require": {
        "php": "^8.4",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/core": "^5.0",
        "symfony/mailer": "^7.0 || ^8.0",
        "symfony/mime": "^7.0 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nvl/settings": "^5.0",
        "nvl/tenancy": "^5.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\MailNotifications\\": "src/",
            "Nvl\\MailNotifications\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\MailNotifications\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "5.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\MailNotifications\\Providers\\MailNotificationsServiceProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "nvl/settings": "Enables tenant-selected delivery profiles through the loaded Settings provider.",
        "nvl/tenancy": "Enables enforcing tenant ownership, scoped execution, adoption, and captured tenant queue contexts."
    },
    "conflict": {
        "nvl/settings": "<5.0 || >=6.0",
        "nvl/tenancy": "<5.0 || >=6.0"
    },
    "homepage": "https://github.com/nvl-laravel-suite/mail-notifications",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/mail-notifications",
        "docs": "https://github.com/nvl-laravel-suite/mail-notifications#readme",
        "issues": "https://github.com/nvl-laravel-suite/mail-notifications/issues",
        "security": "https://github.com/nvl-laravel-suite/mail-notifications/security/policy"
    }
}

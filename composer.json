{
    "name": "nvl/mail-notifications",
    "description": "Embeddable Laravel email delivery, provider sync, private attachments, event tracking and signed callbacks",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "mail",
        "email",
        "tracking",
        "notifications",
        "scheduling",
        "mailersend",
        "delivery",
        "attachments",
        "webhooks",
        "callbacks",
        "sendgrid",
        "mailgun"
    ],
    "require": {
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.8.2 || ^8.0",
        "guzzlehttp/psr7": "^2.7 || ^3.0",
        "laravel/framework": "^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/core": "^7.0",
        "nvl/media": "^7.0",
        "php": "^8.4",
        "psr/http-message": "^2.0",
        "symfony/http-foundation": "^7.4.19 || ^8.1.7",
        "symfony/mailer": "^7.0 || ^8.0",
        "symfony/mime": "^7.0 || ^8.0",
        "tijsverkoyen/css-to-inline-styles": "^2.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nvl/ownership": "^7.0",
        "nvl/settings": "^7.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "symfony/process": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\MailNotifications\\": "src/",
            "Nvl\\MailNotifications\\Database\\Factories\\": "database/factories/",
            "Nvl\\MailNotifications\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/Support/legacy-managed-namespaces.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\MailNotifications\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "7.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\MailNotifications\\Providers\\MailNotificationsServiceProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep",
            ".DS_Store"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "nvl/ownership": "Adds optional model-declared ownership, isolation, adoption and captured worker contexts.",
        "nvl/settings": "Enables configured delivery profiles through the loaded Settings provider."
    },
    "conflict": {
        "nvl/ownership": "<7.0 || >=8.0",
        "nvl/settings": "<7.0 || >=8.0"
    },
    "homepage": "https://github.com/nvl-laravel-suite/mail-notifications",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/mail-notifications",
        "docs": "https://github.com/nvl-laravel-suite/mail-notifications#readme",
        "issues": "https://github.com/nvl-laravel-suite/mail-notifications/issues",
        "security": "https://github.com/nvl-laravel-suite/mail-notifications/security/policy"
    }
}
